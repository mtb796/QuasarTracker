# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Postgres connection string. Free tiers: neon.tech, supabase.com, or Vercel
# Postgres. Use the POOLED string if the provider offers one — serverless opens
# a connection per instance and a pooler keeps that from exhausting the limit.
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# Signs the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------------
# AppFolio Reporting API
# ---------------------------------------------------------------------------
# Your AppFolio subdomain. If you log in at https://acme.appfolio.com, this is "acme".
APPFOLIO_DATABASE=""

# Client ID and secret from AppFolio (Settings > Integrations > API, or via your
# AppFolio account rep — the Reporting API is a paid add-on that must be enabled).
APPFOLIO_CLIENT_ID=""
APPFOLIO_CLIENT_SECRET=""

# API version segment in the report URL. AppFolio has shipped v0, v1 and v2;
# v2 is current for most accounts. If sync returns 404, try "v1".
APPFOLIO_API_VERSION="v2"

# ---------------------------------------------------------------------------
# Email digest
# ---------------------------------------------------------------------------
# Without RESEND_API_KEY the digest still runs — it prints to the server log
# instead of sending. That's enough to see exactly what would go out.

# From https://resend.com (free tier covers a two-person team many times over).
RESEND_API_KEY=""

# Sender. Resend's shared address works with no DNS setup, so start there and
# switch to your own domain once it's verified with them.
EMAIL_FROM="Quasar <onboarding@resend.dev>"

# Used for the links inside the email. Set this to your deployed URL.
APP_URL="http://localhost:3000"

# Shared secret for the scheduled send. Without it /api/cron/digest refuses to
# run at all, so an unprotected endpoint can never email people. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# By default a digest with nothing due is not sent, so the mail stays meaningful.
# Set to "true" to receive one every scheduled day regardless.
DIGEST_ALWAYS_SEND="false"
